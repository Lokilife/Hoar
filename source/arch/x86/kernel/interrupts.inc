section .text

extern interruptHandlers
extern fallbackInterruptHandler

interrupt_common:
    pusha
    push ds
    push es
    push fs
    push gs

    mov ax, 0x10 ; Kernel Data Segment
    mov ds, ax
    mov es, ax
    mov fs, ax
    mov gs, ax

    mov eax, [esp + 48] ; int no
    mov edx, [interruptHandlers + eax * 4]
    test edx, edx
    jz .fallback

    push esp
    call edx
    add esp, 4
    jmp .end
.fallback:
    push esp
    call fallbackInterruptHandler
    add esp, 4
.end:
    pop gs
    pop fs
    pop es
    pop ds
    popa
    add esp, 8
    cld
    iret

%macro INTERRUPT_NOERRCODE 1
global interrupt%1
interrupt%1:
    push 0          ; fake error code
    push %1         ; interrupt index
    jmp interrupt_common
%endmacro

%macro INTERRUPT_ERRCODE 1
global interrupt%1
interrupt%1:
    push %1         ; interrupt index
    jmp interrupt_common
%endmacro


