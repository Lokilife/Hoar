/* init.data.ldh - Construct IDT and GDT entries using linker arithmetic */
idt_start = .;

#define DEFINE_IDT_ENTRY(handler, attrs) \
    SHORT((handler) & 0xFFFF);         \
    SHORT(0x08);                       \
    BYTE(0);                           \
    BYTE(attrs);                       \
    SHORT(((handler) >> 16) & 0xFFFF)

#define INT_TASK_GATE       0x05
#define INT_INTR16_GATE     0x06
#define INT_TRAP16_GATE     0x07
#define INT_INTR32_GATE     0x0E
#define INT_TRAP32_GATE     0x0F

#define INT_DPL0            0x00
#define INT_DPL3            0x60

#define INT_PRESENT         0x80

#define INT_INTR0_ATTRS     (INT_PRESENT | INT_INTR32_GATE | INT_DPL0)
#define INT_INTR3_ATTRS     (INT_PRESENT | INT_INTR32_GATE | INT_DPL3)
#define INT_TRAP3_ATTRS     (INT_PRESENT | INT_TRAP32_GATE | INT_DPL3)

#define KERNEL_CS           0x08

DEFINE_IDT_ENTRY(interrupt0,    INT_INTR0_ATTRS) /* #DE - Divide Error */
DEFINE_IDT_ENTRY(interrupt1,    INT_INTR0_ATTRS) /* #DB - Debug */
DEFINE_IDT_ENTRY(interrupt2,    INT_INTR0_ATTRS) /* NMI */
DEFINE_IDT_ENTRY(interrupt3,    INT_INTR3_ATTRS) /* #BP - Breakpoint */
DEFINE_IDT_ENTRY(interrupt4,    INT_INTR0_ATTRS) /* #OF - Overflow */
DEFINE_IDT_ENTRY(interrupt5,    INT_INTR0_ATTRS) /* #BR - BOUND Rage */
DEFINE_IDT_ENTRY(interrupt6,    INT_INTR0_ATTRS) /* #UD - Invalid Opcode */
DEFINE_IDT_ENTRY(interrupt7,    INT_INTR0_ATTRS) /* #NM - Device Not Available */
DEFINE_IDT_ENTRY(interrupt8,    INT_INTR0_ATTRS) /* #DF - Double Fault */
DEFINE_IDT_ENTRY(interrupt9,    INT_INTR0_ATTRS) /* Coprocessor Segment Overrun */
DEFINE_IDT_ENTRY(interrupt10,   INT_INTR0_ATTRS) /* #TS - Invalid TSS */
DEFINE_IDT_ENTRY(interrupt11,   INT_INTR0_ATTRS) /* #NP - Segment Not Present */
DEFINE_IDT_ENTRY(interrupt12,   INT_INTR0_ATTRS) /* #SS - Stack Fault */
DEFINE_IDT_ENTRY(interrupt13,   INT_INTR0_ATTRS) /* #GP - General Protection */
DEFINE_IDT_ENTRY(interrupt14,   INT_INTR0_ATTRS) /* #PF - Page Fault */
DEFINE_IDT_ENTRY(interrupt15,   INT_INTR0_ATTRS) /* Reserved */
DEFINE_IDT_ENTRY(interrupt16,   INT_INTR0_ATTRS) /* #MF - Floating-Point Error */
DEFINE_IDT_ENTRY(interrupt17,   INT_INTR0_ATTRS) /* #AC - Alignment Check */
DEFINE_IDT_ENTRY(interrupt18,   INT_INTR0_ATTRS) /* #MC - Machine Check */
DEFINE_IDT_ENTRY(interrupt19,   INT_INTR0_ATTRS) /* #XM - SIMD Floating-Point */
DEFINE_IDT_ENTRY(interrupt20,   INT_INTR0_ATTRS) /* #VE - Virtualization Exception */
DEFINE_IDT_ENTRY(interrupt21,   INT_INTR0_ATTRS) /* #CP - Control Protection Exception */
DEFINE_IDT_ENTRY(interrupt22,   INT_INTR0_ATTRS) /* Reserved */
DEFINE_IDT_ENTRY(interrupt23,   INT_INTR0_ATTRS) /* Reserved */
DEFINE_IDT_ENTRY(interrupt24,   INT_INTR0_ATTRS) /* Reserved */
DEFINE_IDT_ENTRY(interrupt25,   INT_INTR0_ATTRS) /* Reserved */
