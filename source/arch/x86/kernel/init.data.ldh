#define GDT_PRESENT     0x80
#define GDT_RING0       0x00
#define GDT_RING3       0x60
#define GDT_SYSTEM      0x10   /* 1 = code/data, 0 = system (TSS/LDT) */
#define GDT_EXECUTABLE  0x08
#define GDT_CONFORMING  0x04
#define GDT_DIRECTION   0x04
#define GDT_READWRITE   0x02
#define GDT_ACCESSED    0x01

#define GDT_GRANULAR4K  0x80
#define GDT_PROTECTED   0x40
#define GDT_LONGMODE    0x20

#define DEFINE_GDT_ENTRY(base, limit, access, flags)                         \
    SHORT((limit) & 0xFFFF);                                                 \
    SHORT((base)  & 0xFFFF);                                                 \
    BYTE(((base) >> 16) & 0xFF);                                             \
    BYTE(access);                                                            \
    BYTE(((flags) & 0xF0) | (((limit) >> 16) & 0x0F));                       \
    BYTE(((base) >> 24) & 0xFF)

gdt_start = .;
DEFINE_GDT_ENTRY(0, 0, 0, 0)                                          /* 0x00 null            */
DEFINE_GDT_ENTRY(0, 0xFFFFF,                                          /* 0x08 kernel code     */
    GDT_PRESENT | GDT_RING0 | GDT_SYSTEM | GDT_EXECUTABLE | GDT_READWRITE,
    GDT_GRANULAR4K | GDT_PROTECTED)
DEFINE_GDT_ENTRY(0, 0xFFFFF,                                          /* 0x10 kernel data     */
    GDT_PRESENT | GDT_RING0 | GDT_SYSTEM | GDT_READWRITE,
    GDT_GRANULAR4K | GDT_PROTECTED)
DEFINE_GDT_ENTRY(0, 0xFFFFF,                                          /* 0x18 user code       */
    GDT_PRESENT | GDT_RING3 | GDT_SYSTEM | GDT_EXECUTABLE | GDT_READWRITE,
    GDT_GRANULAR4K | GDT_PROTECTED)
DEFINE_GDT_ENTRY(0, 0xFFFFF,                                          /* 0x20 user data       */
    GDT_PRESENT | GDT_RING3 | GDT_SYSTEM | GDT_READWRITE,
    GDT_GRANULAR4K | GDT_PROTECTED)
DEFINE_GDT_ENTRY(ia32_tss_segment,                                    /* 0x28 TSS             */
    ia32_tss_segment_end - ia32_tss_segment - 1,
    0x89,
    0)
gdt_end = .;

gdtr = .;
SHORT(gdt_end - gdt_start - 1);
LONG(gdt_start);
